# Shared
APP_ENV=development

# Justapedia
JUSTAPEDIA_API_URL=https://justapedia.org/api.php
JUSTAPEDIA_REQUEST_TIMEOUT=20
JUSTAPEDIA_MAX_RETRIES=3
JUSTAPEDIA_CACHE_TTL_SECONDS=300



# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CHAT_MAX_CONTEXT_CHUNKS=6
CHAT_MAX_SEARCH_RESULTS=5
CHAT_MAX_ARTICLES=3

# Database

# Redis (Phase 2)
REDIS_URL=redis://localhost:6379/0

# Embeddings (Phase 2)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
